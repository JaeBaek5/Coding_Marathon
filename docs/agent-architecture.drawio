<mxfile>
  <diagram name="전체 아키텍처" id="arch-main">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== 제목 ===== -->
        <mxCell id="t1" value="Mumuk - 멀티 에이전트 시스템 아키텍처" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="10" width="740" height="40" />
        </mxCell>
        <mxCell id="t2" value="Agent Swarm Architecture with 7 Specialized Agents" style="text;html=1;fontSize=12;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="430" y="50" width="540" height="20" />
        </mxCell>

        <!-- ===== LEGEND ===== -->
        <mxCell id="legend-box" value="&lt;b&gt;범례&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1090" y="10" width="290" height="210" />
