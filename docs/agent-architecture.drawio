        <mxCell id="leg-swim" value="" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=0;rounded=1;fillColor=#eef4fa;strokeColor=#b0c4de;container=0;collapsible=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="38" width="50" height="16" />
        </mxCell>
        <mxCell id="leg-swim-t" value="Swimlane (레이어)" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1155" y="35" width="100" height="20" />
        </mxCell>
        <mxCell id="leg-agent" value="" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="60" width="50" height="16" />
        </mxCell>
        <mxCell id="leg-agent-t" value="Agent (에이전트)" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1155" y="57" width="100" height="20" />
        </mxCell>
        <mxCell id="leg-dec" value="&lt;b&gt;조건?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1105" y="82" width="40" height="40" />
        </mxCell>
        <mxCell id="leg-dec-t" value="Decision (분기)" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1155" y="92" width="100" height="20" />
        </mxCell>
        <mxCell id="leg-ext" value="API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="128" width="50" height="16" />
        </mxCell>
        <mxCell id="leg-ext-t" value="External Service" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1155" y="125" width="100" height="20" />
        </mxCell>
        <mxCell id="leg-slot" value="슬롯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="1098" y="155" width="50" height="20" />
        </mxCell>
        <mxCell id="leg-slot-t" value="자연어에서 추출한 구조화된 검색 조건&lt;br&gt;(예: budget, time, vibe, transportMode 등)" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1155" y="152" width="210" height="36" />
        </mxCell>
        <mxCell id="leg-slot-ref" value="※ 슬롯 충족 = 사용자가&lt;br&gt;  모든 검색 조건을 제공함" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1098" y="178" width="200" height="28" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- LAYER 1: 사용자 인터페이스 (Client Layer)                          -->
        <!-- ================================================================ -->
        <mxCell id="L1-swim" value="&lt;b&gt;01. 사용자 인터페이스 (Client Layer)&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;rounded=1;fillColor=#eef4fa;strokeColor=#b0c4de;container=1;collapsible=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="1260" height="120" />
        </mxCell>
        <mxCell id="L1-inner" value="" style="points=[];verticalAlign=top;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="L1-swim">
          <mxGeometry x="8" y="32" width="1244" height="83" />
        </mxCell>

        <!-- 사용자 입력 -->
        <mxCell id="user-input" value="&lt;b&gt;사용자&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&quot;상사랑 점심 1만원...&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=12;" vertex="1" parent="L1-swim">
          <mxGeometry x="30" y="45" width="150" height="50" />
        </mxCell>
        <!-- Textarea -->
        <mxCell id="client-textarea" value="&lt;b&gt;질문 입력&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;textarea#query-text-area&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;arcSize=6;" vertex="1" parent="L1-swim">
          <mxGeometry x="240" y="45" width="100" height="50" />
        </mxCell>
        <!-- Map -->
        <mxCell id="client-map" value="&lt;b&gt;네이버 지도&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;MapPlaceholder.svelte&lt;br&gt;마커 + 폴리라인&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;arcSize=8;" vertex="1" parent="L1-swim">
          <mxGeometry x="380" y="45" width="120" height="50" />
        </mxCell>
        <!-- Results List -->
        <mxCell id="client-results" value="&lt;b&gt;결과 리스트&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;ResultsList.svelte&lt;br&gt;클릭 → 지도 연동&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;arcSize=8;" vertex="1" parent="L1-swim">
          <mxGeometry x="540" y="45" width="120" height="50" />
        </mxCell>
        <!-- Question Form -->
        <mxCell id="client-questions" value="&lt;b&gt;추가 질문 폼&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;QuestionForm.svelte&lt;br&gt;최대 2회 렌더링&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;arcSize=8;" vertex="1" parent="L1-swim">
          <mxGeometry x="700" y="45" width="120" height="50" />
        </mxCell>
        <!-- Session Store -->
        <mxCell id="client-store" value="&lt;b&gt;세션 스토어&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;session.svelte.js&lt;br&gt;$state runes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;arcSize=8;" vertex="1" parent="L1-swim">
          <mxGeometry x="870" y="45" width="120" height="50" />
        </mxCell>

        <!-- 화살표: 사용자 → Textarea -->
        <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="L1-swim" source="user-input" target="client-textarea">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1-l" value="자연어 입력" style="edgeLabel;html=1;fontSize=9;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c1">
          <mxGeometry x="-0.2" y="-1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- ================================================================ -->
        <!-- LAYER 2: 오케스트레이션 & 게이트키핑 (Orchestration Layer)         -->
        <!-- ================================================================ -->
        <mxCell id="L2-swim" value="&lt;b&gt;02. 오케스트레이션 &amp; 게이트키핑 (Orchestration Layer)&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;rounded=1;fillColor=#eef4fa;strokeColor=#b0c4de;container=1;collapsible=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="220" width="1260" height="240" />
        </mxCell>
        <mxCell id="L2-inner" value="" style="points=[];verticalAlign=top;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="L2-swim">
          <mxGeometry x="8" y="32" width="1244" height="200" />
        </mxCell>

        <!-- Aria: Gatekeeper -->
        <mxCell id="aria" value="&lt;b&gt;Aria (Gatekeeper)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;자연어 → 슬롯 구조화&lt;br&gt;Regex + LLM Tool Calling&lt;br&gt;미래 시제 감지/차단&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="L2-swim">
          <mxGeometry x="30" y="50" width="160" height="70" />
        </mxCell>

        <!-- Decision: 슬롯 충분? -->
        <mxCell id="dec-slots" value="&lt;b&gt;슬롯&lt;br&gt;충분?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="L2-swim">
          <mxGeometry x="270" y="55" width="80" height="70" />
        </mxCell>

        <!-- Decision: 미래 계획? -->
        <mxCell id="dec-future" value="&lt;b&gt;미래&lt;br&gt;시제?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="L2-swim">
          <mxGeometry x="270" y="155" width="80" height="50" />
        </mxCell>

        <!-- SCHEDULED_MEAL_UNSUPPORTED -->
        <mxCell id="error-future" value="&lt;b&gt;SCHEDULED_MEAL&lt;br&gt;_UNSUPPORTED&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;400 Bad Request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="L2-swim">
          <mxGeometry x="90" y="155" width="130" height="50" />
        </mxCell>

        <!-- INVALID_TOTAL_TIME -->
        <mxCell id="error-time" value="&lt;b&gt;INVALID_&lt;br&gt;TOTAL_TIME&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;20~60분 범위 벗어남&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="L2-swim">
          <mxGeometry x="90" y="155" width="130" height="50" />
        </mxCell>

        <!-- Aria → Decision arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="L2-swim" source="aria" target="dec-slots">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Decision 슬롯 충분 → Yes flow (to next layer) -->
        <mxCell id="d1y" value="Yes (모든 슬롯 충족)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;entryX=0.5;entryY=0;strokeWidth=1;strokeColor=#28a745;fontSize=9;" edge="1" parent="L2-swim" target="L3-swim">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="70" as="sourcePoint" />
            <mxPoint x="680" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Decision 슬롯 충분 → No flow -->
        <mxCell id="d1n" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.3;entryY=0;strokeWidth=1;strokeColor=#dc3545;fontSize=9;" edge="1" parent="L2-swim" source="dec-slots" target="rudy">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="130" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- ================================================================ -->
        <!-- LAYER 3: 다이얼로그 & 질문 수집 (Dialog Layer)                     -->
        <!-- ================================================================ -->
        <mxCell id="L3-swim" value="&lt;b&gt;03. 다이얼로그 &amp; 질문 수집 (Dialog Layer)&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;rounded=1;fillColor=#f0e6f6;strokeColor=#c0a0d0;container=1;collapsible=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="480" width="1260" height="240" />
        </mxCell>
        <mxCell id="L3-inner" value="" style="points=[];verticalAlign=top;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="L3-swim">
          <mxGeometry x="8" y="32" width="1244" height="200" />
        </mxCell>

        <!-- Rudy: Dialog Manager -->
        <mxCell id="rudy" value="&lt;b&gt;Rudy (Dialog Manager)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;누락 슬롯 질문 생성&lt;br&gt;SlotPriorityOrder 따라&lt;br&gt;최대 2회까지만 질문&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="L3-swim">
          <mxGeometry x="30" y="50" width="160" height="70" />
        </mxCell>

        <!-- Decision: 2회 초과? -->
        <mxCell id="dec-expire" value="&lt;b&gt;2회&lt;br&gt;초과?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="L3-swim">
          <mxGeometry x="270" y="55" width="80" height="70" />
        </mxCell>

        <!-- SESSION_EXPIRED -->
        <mxCell id="error-expired" value="&lt;b&gt;SESSION_&lt;br&gt;EXPIRED&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:8px'&gt;410 Gone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="L3-swim">
          <mxGeometry x="90" y="155" width="120" height="50" />
        </mxCell>

        <!-- 사용자 응답 대기 (Client) -->
        <mxCell id="wait-user" value="&lt;b&gt;클라이언트로 전송&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;status: 'questions'&lt;br&gt;questions: [...]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;arcSize=8;" vertex="1" parent="L3-swim">
          <mxGeometry x="420" y="55" width="140" height="60" />
        </mxCell>

        <!-- Rudy → 초과? -->
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="L3-swim" source="rudy" target="dec-expire">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 초과 No → 클라이언트 -->
        <mxCell id="e1n" value="No (질문 전송)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;strokeWidth=1;strokeColor=#28a745;fontSize=9;" edge="1" parent="L3-swim" source="dec-expire" target="wait-user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 초과 Yes → SESSION_EXPIRED -->
        <mxCell id="e1y" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=1;strokeColor=#dc3545;fontSize=9;" edge="1" parent="L3-swim" source="dec-expire" target="error-expired">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 클라이언트 응답 → 재진입 -->
        <mxCell id="reentry" value="사용자 응답 제출 →&lt;br&gt;&lt;b&gt;L2 재진입&lt;/b&gt; (Aria)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;strokeWidth=1;strokeColor=#6c8ebf;fontSize=9;dashed=1;" edge="1" parent="L3-swim" target="aria">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="490" y="55" as="sourcePoint" />
            <mxPoint x="30" y="50" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ================================================================ -->
        <!-- LAYER 4: 데이터 파이프라인 (Data Pipeline Layer)                   -->
        <!-- ================================================================ -->
        <mxCell id="L4-swim" value="&lt;b&gt;04. 데이터 파이프라인 (Data Pipeline Layer)&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;rounded=1;fillColor=#e8f0e8;strokeColor=#a0c0a0;container=1;collapsible=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="740" width="1260" height="350" />
        </mxCell>
        <mxCell id="L4-inner" value="" style="points=[];verticalAlign=top;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="L4-swim">
          <mxGeometry x="8" y="32" width="1244" height="310" />
        </mxCell>

        <!-- Kai: Scout Master -->
        <mxCell id="kai" value="&lt;b&gt;Kai (Scout Master)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Kakao Local API 호출&lt;br&gt;반경 내 식당 검색&lt;br&gt;중복 제거 (50m)&lt;br&gt;정규화 (NormalizedCandidate)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="L4-swim">
          <mxGeometry x="30" y="45" width="160" height="90" />
        </mxCell>

        <!-- 반경 설정 -->
        <mxCell id="radius-box" value="&lt;b&gt;탐색 반경&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;normal+walk=1km&lt;br&gt;normal+drive=5km&lt;br&gt;travel+walk=2km&lt;br&gt;travel+drive=10km&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;arcSize=4;" vertex="1" parent="L4-swim">
          <mxGeometry x="30" y="155" width="120" height="80" />
        </mxCell>

        <!-- Kakao Local API -->
        <mxCell id="kakao-local" value="&lt;b&gt;Kakao Local API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;카테고리 검색&lt;br&gt;키워드 검색&lt;br&gt;CRI (Memory 30분 TTL)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;arcSize=6;" vertex="1" parent="L4-swim">
          <mxGeometry x="250" y="45" width="150" height="70" />
        </mxCell>

        <!-- Path: Route Navigator -->
        <mxCell id="path-agent" value="&lt;b&gt;Path (Route Navigator)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;각 후보 병렬 경로 계산&lt;br&gt;walk → Kakao Mobility&lt;br&gt;drive → Naver Directions&lt;br&gt;시간 예산 필터링&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="L4-swim">
          <mxGeometry x="30" y="250" width="160" height="85" />
        </mxCell>

        <!-- Kakao Mobility -->
        <mxCell id="kakao-mobility" value="&lt;b&gt;Kakao Mobility API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;도보 경로&lt;br&gt;path 좌표 반환&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;arcSize=6;" vertex="1" parent="L4-swim">
          <mxGeometry x="250" y="250" width="150" height="60" />
        </mxCell>

        <!-- Naver Directions -->
        <mxCell id="naver-dir" value="&lt;b&gt;Naver Directions API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;차량 경로&lt;br&gt;실시간 교통 반영&lt;br&gt;path 좌표 반환&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;arcSize=6;" vertex="1" parent="L4-swim">
          <mxGeometry x="430" y="250" width="150" height="60" />
        </mxCell>

        <!-- Iris: Ranker -->
        <mxCell id="iris" value="&lt;b&gt;Iris (Ranker)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;가중치 점수 매기기&lt;br&gt;7개 항목 100점 만점&lt;br&gt;동점자 scoreComponents 정렬&lt;br&gt;최종 상위 5개 선정&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="L4-swim">
          <mxGeometry x="660" y="45" width="160" height="90" />
        </mxCell>

        <!-- Score card -->
        <mxCell id="score-card" value="&lt;b&gt;점수 구성표&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Time Fit (25)&lt;br&gt;Distance Fit (20)&lt;br&gt;Context Fit (15)&lt;br&gt;Vibe Fit (10)&lt;br&gt;Budget Fit (10)&lt;br&gt;Metadata Confidence (10)&lt;br&gt;Category Safety (10)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;arcSize=4;" vertex="1" parent="L4-swim">
          <mxGeometry x="860" y="45" width="140" height="125" />
        </mxCell>

        <!-- Candidate Pool -->
        <mxCell id="candidate-pool" value="&lt;b&gt;후보 풀&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Candidates + Routes&lt;br&gt;→ 정렬된 결과&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;arcSize=8;" vertex="1" parent="L4-swim">
          <mxGeometry x="660" y="155" width="160" height="50" />
        </mxCell>

        <!-- Kai → Kakao Local -->
        <mxCell id="k1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="L4-swim" source="kai" target="kakao-local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k1-l" value="위치+반경 → 검색" style="edgeLabel;html=1;fontSize=8;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k1">
          <mxGeometry x="-0.3" y="-1" relative="1" as="geometry" />
        </mxCell>

        <!-- Kai → 후보 풀 -->
        <mxCell id="k2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="L4-swim" source="kai" target="iris">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="140" as="sourcePoint" />
            <mxPoint x="660" y="90" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2-l" value="NormalizedCandidate[]" style="edgeLabel;html=1;fontSize=8;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="k2">
          <mxGeometry x="0.5" y="-1" relative="1" as="geometry" />
        </mxCell>

        <!-- Path → Kakao Mobility -->
        <mxCell id="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="L4-swim" source="path-agent" target="kakao-mobility">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Path → Naver Directions -->
        <mxCell id="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="L4-swim" source="path-agent" target="naver-dir">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="190" y="275" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- 후보 풀 → Iris -->
        <mxCell id="c2i" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="L4-swim" target="iris">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="180" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- ================================================================ -->
        <!-- LAYER 5: LLM 내레이션 (Narration Layer)                           -->
        <!-- ================================================================ -->
        <mxCell id="L5-swim" value="&lt;b&gt;05. LLM 내레이션 (Narration Layer)&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;rounded=1;fillColor=#fcf0e6;strokeColor=#d0b0a0;container=1;collapsible=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1110" width="1260" height="200" />
        </mxCell>
        <mxCell id="L5-inner" value="" style="points=[];verticalAlign=top;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="L5-swim">
          <mxGeometry x="8" y="32" width="1244" height="160" />
        </mxCell>

        <!-- Sol: Narrator -->
        <mxCell id="sol" value="&lt;b&gt;Sol (Narrator)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;LLM 추천 이유 생성&lt;br&gt;한글 2문장 이내&lt;br&gt;맥락 + 식당 정보 연결&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="L5-swim">
          <mxGeometry x="30" y="45" width="160" height="70" />
        </mxCell>

        <!-- 좌표 필터 -->
        <mxCell id="coord-filter" value="&lt;b&gt;좌표 필터&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;location.lat/.lng 제거&lt;br&gt;프라이버시 보호&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;arcSize=8;" vertex="1" parent="L5-swim">
          <mxGeometry x="250" y="45" width="120" height="50" />
        </mxCell>

        <!-- LLM (OpenAI/Gemini) -->
        <mxCell id="llm-provider" value="&lt;b&gt;LLM Provider&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;OpenAI GPT-4o&lt;br&gt;Gemini Pro&lt;br&gt;(API Key 존재 시 활성화)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;arcSize=6;" vertex="1" parent="L5-swim">
          <mxGeometry x="430" y="45" width="140" height="60" />
        </mxCell>

        <!-- LLM Fallback -->
        <mxCell id="llm-fallback" value="&lt;b&gt;Fallback&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;generateGrounded&lt;br&gt;ExplanationFallback()&lt;br&gt;규칙 기반 설명&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;arcSize=8;" vertex="1" parent="L5-swim">
          <mxGeometry x="430" y="120" width="140" height="55" />
        </mxCell>

        <!-- Sol → 좌표 필터 -->
        <mxCell id="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="L5-swim" source="sol" target="coord-filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s1-l" value="프롬프트 주입" style="edgeLabel;html=1;fontSize=8;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="s1">
          <mxGeometry x="-0.3" y="-1" relative="1" as="geometry" />
        </mxCell>
        <!-- 좌표 필터 → LLM -->
        <mxCell id="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="L5-swim" source="coord-filter" target="llm-provider">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- LAYER 6: 최종 집계 (Output Layer)                                 -->
        <!-- ================================================================ -->
        <mxCell id="L6-swim" value="&lt;b&gt;06. 최종 집계 &amp; 응답 (Output Layer)&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;rounded=1;fillColor=#eef4fa;strokeColor=#b0c4de;container=1;collapsible=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1330" width="1260" height="160" />
        </mxCell>
        <mxCell id="L6-inner" value="" style="points=[];verticalAlign=top;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="L6-swim">
          <mxGeometry x="8" y="32" width="1244" height="120" />
        </mxCell>

        <!-- Ora: Orchestrator -->
        <mxCell id="ora" value="&lt;b&gt;Ora (Orchestrator)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;에이전트 간 Handoff&lt;br&gt;상태 기계 제어&lt;br&gt;세션 생명주기 관리&lt;br&gt;세션 만료 (30분)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="L6-swim">
          <mxGeometry x="30" y="40" width="160" height="80" />
        </mxCell>

        <!-- 최종 JSON -->
        <mxCell id="final-json" value="&lt;b&gt;최종 응답&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;{&lt;br&gt;  status: &quot;results&quot;,&lt;br&gt;  results: [...],&lt;br&gt;  eligibleCount: 5,&lt;br&gt;  sessionId: &quot;ses_xxx&quot;&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=8;" vertex="1" parent="L6-swim">
          <mxGeometry x="280" y="35" width="200" height="90" />
        </mxCell>

        <!-- 에러 응답 -->
        <mxCell id="error-json" value="&lt;b&gt;에러 응답&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;{&lt;br&gt;  status: &quot;error&quot;,&lt;br&gt;  code: &quot;GEO_REQUIRED&quot;,&lt;br&gt;  message: &quot;...&quot;&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;arcSize=8;" vertex="1" parent="L6-swim">
          <mxGeometry x="280" y="35" width="200" height="90" />
        </mxCell>

        <!-- Ora → 결과 -->
        <mxCell id="o1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;" edge="1" parent="L6-swim" source="ora" target="final-json">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================================================================ -->
        <!-- 간 연결 화살표                                                      -->
        <!-- ================================================================ -->
        <!-- L2 Yes → L4 (슬롯 충분 → Data Pipeline) -->
        <mxCell id="cross-l2-l4" value="슬롯 충족 + 위치 있음" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;strokeColor=#28a745;fontSize=10;dashed=1;" edge="1" parent="1" target="L4-swim">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="460" as="sourcePoint" />
            <mxPoint x="680" y="740" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- L4 → L5 (Iris → Sol) -->
        <mxCell id="cross-l4-l5" value="Sorted Results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;strokeColor=#333333;fontSize=10;" edge="1" parent="1" target="L5-swim">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="1090" as="sourcePoint" />
            <mxPoint x="680" y="1110" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- L5 → L6 (LLM 설명 → Ora) -->
        <mxCell id="cross-l5-l6" value="Explanations[]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;strokeColor=#333333;fontSize=10;" edge="1" parent="1" target="L6-swim">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="1310" as="sourcePoint" />
            <mxPoint x="120" y="1330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 최종 응답 → 클라이언트 -->
        <mxCell id="cross-l6-l1" value="최종 JSON 응답 → 클라이언트 렌더링" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;strokeColor=#6c8ebf;fontSize=9;dashed=1;" edge="1" parent="1" target="L1-swim">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="1400" as="sourcePoint" />
            <mxPoint x="100" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ================================================================ -->
        <!-- 데이터 저장소 및 캐시                                              -->
        <!-- ================================================================ -->
        <mxCell id="cache-box" value="&lt;b&gt;캐시 계층 (TTL 30분)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;nearby:{lat}:{lng}:{radius}&lt;br&gt;route:{mode}:{start}:{end}&lt;br&gt;keyword:{query}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="380" width="200" height="70" />
        </mxCell>
        <mxCell id="cache-label" value="Kai/Path가 먼저 캐시 조회&lt;br&gt;MISS 시에만 API 호출" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeWidth=1;strokeColor=#6c8ebf;fontSize=8;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1050" y="415" as="sourcePoint" />
            <mxPoint x="440" y="820" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ================================================================ -->
        <!-- 에이전트 요약 표                                                   -->
        <!-- ================================================================ -->
        <mxCell id="agent-table" value='&lt;b&gt;에이전트 요약&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;table&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Aria&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Gatekeeper&lt;/td&gt;&lt;td&gt;입력 파싱 및 구조화&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Ora&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Orchestrator&lt;/td&gt;&lt;td&gt;상태 기계 및 Handoff&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Rudy&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dialog Manager&lt;/td&gt;&lt;td&gt;질문 생성 (최대 2회)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Kai&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Scout Master&lt;/td&gt;&lt;td&gt;식당 검색 및 정규화&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Path&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Route Navigator&lt;/td&gt;&lt;td&gt;경로 계산 및 필터&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Iris&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Ranker&lt;/td&gt;&lt;td&gt;점수 매기기 및 정렬&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Sol&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Narrator&lt;/td&gt;&lt;td&gt;LLM 설명 생성&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1060" y="580" width="240" height="205" />
        </mxCell>

      </root>
    </mxGraphModel>
