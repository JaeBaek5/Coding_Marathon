# poc/.env  — 이 파일을 복사해 같은 폴더에 .env 로 저장하고 실제 키를 채우세요.
# (.env 는 .gitignore 되지만, 이 .env.example 은 커밋되므로 실제 키를 넣지 마세요)

# Kakao Developers > 내 앱 > 앱 키 > REST API 키
# 용도: 식당 검색(Local) + 도보 경로(Mobility)
KAKAO_API_KEY=

# Naver Cloud Platform(console.ncloud.com) > Maps > 인증 정보
# 용도: 차량 경로(Directions 5) + 역지오코딩(좌표→지역명)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# developers.naver.com > 애플리케이션 등록 > 검색 API (위와 별개의 키!)
# 용도: 네이버 지역(맛집) 검색
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=

# (선택) 추천 이유·메뉴판 Vision — 역할별 모델 분리 (llm_roles.py 참고)
OPENROUTER_API_KEY=
LLM_ROLE_REASON_MODEL=google/gemini-2.5-flash-lite
LLM_ROLE_VISION_MODEL=google/gemini-2.5-flash
# 하위 호환
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# 역할별 토큰 상한
OPENROUTER_MAX_TOKENS_LLM=200
OPENROUTER_MAX_TOKENS_VISION=512

# 파이프라인 호출 제한
POC_MAX_ROUTE_CALLS=4
POC_MAX_VISION_CALLS=1
POC_ENABLE_VISION=true
