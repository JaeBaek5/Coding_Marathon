# Mumuk Environment Variables (Root)
VITE_API_URL=http://localhost:8787

# Live map and provider APIs
KAKAO_API_KEY=
NAVER_MAP_CLIENT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# LLM Swarm Runtime (OpenRouter by default)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
LLM_TIMEOUT_MS=60000

# Optional OpenAI-compatible override
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.6
LLM_MODEL_ORCHESTRATOR=
LLM_MODEL_ALEPH=
LLM_MODEL_BET=
LLM_MODEL_GIMEL=
