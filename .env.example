# Mumuk Environment Variables (Root)
VITE_API_URL=http://localhost:8787

# Naver Local Search (developers.naver.com)
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=

# Naver Cloud Platform Maps (geocoding, directions)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# LLM Swarm Runtime (OpenRouter — 역할별 모델 권장)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
LLM_TIMEOUT_MS=90000

# 비우면 OPENROUTER_MODEL 또는 역할별 기본값 사용
LLM_MODEL_ORCHESTRATOR=google/gemini-2.5-flash-lite
LLM_MODEL_ALEPH=anthropic/claude-sonnet-4.6
LLM_MODEL_BET=google/gemini-2.5-flash
LLM_MODEL_GIMEL=anthropic/claude-sonnet-4.6

# Optional OpenAI-compatible override
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.6
