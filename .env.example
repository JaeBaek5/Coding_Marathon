# Mumuk Environment Variables (Root)
VITE_API_URL=http://localhost:8787

# Naver Local Search (developers.naver.com)
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=

# Naver Cloud Platform Maps (geocoding, directions)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# LLM Swarm Runtime (OpenRouter by default)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
LLM_TIMEOUT_MS=60000

# Optional OpenAI-compatible override
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.6
LLM_MODEL_ORCHESTRATOR=
LLM_MODEL_ALEPH=
LLM_MODEL_BET=
LLM_MODEL_GIMEL=
