# Mumuk Server Environment Variables
PORT=8787
NODE_ENV=development

# Naver Local Search (developers.naver.com)
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=

# Naver Cloud Platform Maps (geocoding, directions)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# LLM Swarm Runtime (OpenRouter by default)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-4.8-fast
LLM_TIMEOUT_MS=60000
